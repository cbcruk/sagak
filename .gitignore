# Prevent compiled files in source directories
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/*/test/**/*.js
packages/*/test/**/*.d.ts
packages/*/test/**/*.d.ts.map


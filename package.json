{
  "name": "sagak-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter sagak-app dev",
    "build": "pnpm --filter sagak-app build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --sequential test",
    "test:run": "pnpm --filter sagak-core test:run",
    "test:ui": "pnpm --filter sagak-ui test",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "preview": "pnpm --filter sagak-app preview",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "test:core": "pnpm --filter sagak-core test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "svelte": "^5.56.9",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "lucide": "^1.31.0",
    "nanostores": "^1.4.2"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "@vitest/browser/providers/playwright"
    ],
    "paths": {
      "sagak-core": [
        "../../packages/core/src/index.ts"
      ],
      "@/*": [
        "../../packages/core/src/*"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}

  "repository": {
    "type": "git",
    "url": "https://github.com/cbcruk/sagak.git"
  },
  "dependencies": {
    "sagak-core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser": "3.2.4",
    "playwright": "^1.57.0",
    "tsup": "^8.4.0",
    "typescript": "6.0.0-beta",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "private": true
}

{
  "name": "sagak-ui",
  "version": "0.1.0",
  "description": "sagak 에디터 UI 컴포넌트 (Svelte) — 워크스페이스 내부 패키지",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",

{
  "name": "sagak-editor",
  "version": "0.1.0",
  "description": "A modern, feature-rich WYSIWYG editor for React",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "editor",
    "wysiwyg",
    "rich-text",
    "react",
    "contenteditable",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/sagak-editor.git",
    "directory": "packages/react"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "lucide-preact": "^0.562.0",
    "sagak-core": "workspace:*"
  },
  "devDependencies": {
    "@base-ui/react": "^1.0.0",
    "@preact/preset-vite": "^2.9.0",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/preact-vite": "10.1.11",
    "@vitest/browser": "3.2.4",
    "eslint-plugin-storybook": "10.1.11",
    "playwright": "^1.57.0",
    "preact": "^10.24.0",
    "storybook": "^10.1.11",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "private": true
}

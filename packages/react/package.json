{
  "name": "sagak-editor",
  "version": "0.1.0",
  "description": "A modern, feature-rich WYSIWYG editor for Preact",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./src/styles/index.css",
    "./styles.css": "./src/styles/index.css"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "editor",
    "wysiwyg",
    "rich-text",
    "preact",
    "contenteditable",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/sagak-editor.git",
    "directory": "packages/react"
  },
  "dependencies": {
    "lucide-preact": "^0.562.0",
    "sagak-core": "workspace:*"
  },
  "peerDependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.0.0",
    "@preact/preset-vite": "^2.9.0",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/preact-vite": "10.1.11",
    "@vitest/browser": "3.2.4",
    "eslint-plugin-storybook": "10.1.11",
    "playwright": "^1.57.0",
    "preact": "^10.24.0",
    "storybook": "^10.1.11",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}

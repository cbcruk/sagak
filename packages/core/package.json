{
  "name": "sagak-core",
  "version": "0.1.0",
  "description": "Core library for Sagak Editor - a modern WYSIWYG editor",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "editor",
    "wysiwyg",
    "rich-text",
    "contenteditable",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbcruk/sagak.git",
    "directory": "packages/core"
  },
  "devDependencies": {
    "tsup": "^8.4.0"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-tables": "^1.8.5"
  },
  "private": true
}
